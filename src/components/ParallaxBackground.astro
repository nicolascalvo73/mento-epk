---
import { Image } from 'astro:assets';
import bgPlaceholder from '@/assets/images/bg-placeholder.jpg';
---

<!--
  Full-viewport background image that GSAP ScrollTrigger moves at a slower
  rate than the page scroll, creating the parallax effect.
  Image passes through astro:assets pipeline: WebP/AVIF srcset, responsive sizes.
  If prefers-reduced-motion: image stays fixed (CSS), GSAP never runs (parallax.ts).
-->
<div class="parallax-container" aria-hidden="true">
  <Image
    src={bgPlaceholder}
    alt=""
    class="parallax-bg"
    widths={[768, 1280, 1920]}
    sizes="100vw"
    formats={['avif', 'webp', 'jpeg']}
    quality={80}
    loading="eager"
    decoding="sync"
  />
</div>

<style>
  .parallax-container {
    position: fixed;
    inset: -30% 0;   /* oversized so the parallax movement doesn't reveal edges */
    z-index: var(--z-bg);
    overflow: hidden;
  }

  .parallax-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    /* If reduced motion: image is effectively fixed because GSAP never runs */
  }

  @media (prefers-reduced-motion: reduce) {
    .parallax-container {
      inset: 0;   /* no extra space needed; image is truly fixed */
    }
  }
</style>
