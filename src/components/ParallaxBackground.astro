---
import { Image } from 'astro:assets';
import bgImage from '@/assets/images/background.jpg';
---

<!--
  Full-viewport background image that GSAP ScrollTrigger moves at a slower
  rate than the page scroll, creating the parallax effect.
  Image passes through astro:assets pipeline: WebP/AVIF srcset, responsive sizes.
  If prefers-reduced-motion: image stays fixed (CSS), GSAP never runs (parallax.ts).
-->
<div class="parallax-container" aria-hidden="true">
  <Image
    src={bgImage}
    alt=""
    class="parallax-bg"
    widths={[768, 1280, 1920]}
    sizes="100vw"
    formats={['avif', 'webp', 'jpeg']}
    quality={80}
    loading="eager"
    decoding="sync"
  />
</div>

<style>
  .parallax-container {
    position: fixed;
    /* Oversized so the vertical parallax scroll and the rightward shift
       below don't reveal edges. GSAP animates .parallax-bg's own transform
       for the scroll effect, so the static horizontal shift lives here on
       the container instead, to avoid the two transforms fighting. */
    inset: -30% -1.5rem;
    transform: translateX(1.5rem);
    z-index: var(--z-bg);
    overflow: hidden;
  }

  .parallax-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: brightness(0.5);
    opacity: 0;
    transition: opacity 1s ease;
  }

  /* Added once the logo draw-in finishes (logo-animation.ts) */
  .parallax-bg.is-visible {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .parallax-container {
      inset: 0 -1.5rem;
    }
    .parallax-bg {
      opacity: 1;
      transition: none;
    }
  }
</style>
