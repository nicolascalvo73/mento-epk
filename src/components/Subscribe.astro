---
// Buttondown action URL — replace BUTTONDOWN_USERNAME with the real account
const ACTION_URL = 'https://buttondown.email/BUTTONDOWN_USERNAME';
---

<section id="subscribe" class="section subscribe" aria-labelledby="subscribe-heading">
  <div class="section__inner subscribe__inner">

    <div class="subscribe__copy">
      <h2 id="subscribe-heading" class="subscribe__heading">Stay close</h2>
      <p class="subscribe__sub">
        No noise. We write when something is worth writing about.
      </p>
    </div>

    <form
      class="subscribe__form"
      action={ACTION_URL}
      method="POST"
      aria-label="Email subscription form"
    >
      <div class="subscribe__field">
        <label for="subscribe-email" class="sr-only">Email address</label>
        <input
          id="subscribe-email"
          type="email"
          name="email"
          placeholder="your@email.com"
          required
          autocomplete="email"
          class="subscribe__input"
          aria-required="true"
        />
        <button type="submit" class="subscribe__btn" aria-label="Subscribe">
          <span aria-hidden="true">→</span>
          <span class="sr-only">Subscribe</span>
        </button>
      </div>

      <p class="subscribe__fine">
        No spam. Unsubscribe anytime. Powered by
        <a href="https://buttondown.email" rel="noopener noreferrer" target="_blank">Buttondown</a>.
      </p>
    </form>

  </div>
</section>

<style>
  .subscribe__inner {
    display: grid;
    gap: var(--space-lg);
    align-items: center;

    @media (min-width: 768px) {
      grid-template-columns: 1fr 1fr;
    }
  }

  .subscribe__heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 400;
    color: var(--color-text);
    line-height: 1.1;
  }

  .subscribe__sub {
    margin-top: var(--space-sm);
    color: var(--color-accent);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .subscribe__field {
    display: flex;
    border-bottom: 1px solid rgba(255,255,255,0.3);
    transition: border-color 0.2s ease;
  }

  .subscribe__field:focus-within {
    border-color: var(--color-accent);
  }

  .subscribe__input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--color-text);
    font-size: 1rem;
    padding: var(--space-sm) 0;
    outline: none;
    caret-color: var(--color-accent);
  }

  .subscribe__input::placeholder {
    color: var(--color-muted);
  }

  .subscribe__btn {
    padding: var(--space-sm) var(--space-sm);
    color: var(--color-accent);
    font-size: 1.4rem;
    line-height: 1;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .subscribe__btn:hover {
    transform: translateX(4px);
    color: var(--color-text);
  }

  .subscribe__btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .subscribe__fine {
    margin-top: var(--space-sm);
    font-size: 0.7rem;
    color: var(--color-muted);
    letter-spacing: 0.05em;
  }

  .subscribe__fine a {
    color: var(--color-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
