---

<footer class="footer" aria-label="Pie de página">
  <div class="footer__inner">

    <div class="footer__contact">
      <p class="footer__contact-label">Prensa, booking y colaboraciones</p>
      <div class="footer__contact-links">
        <a href="mailto:hola@mentomusica.com.ar" class="footer__contact-link">
          <span class="footer__contact-tag">mail</span>
          hola@mentomusica.com.ar
        </a>
        <a
          href="https://www.instagram.com/mentomusica"
          target="_blank"
          rel="noopener noreferrer"
          class="footer__contact-link"
        >
          <span class="footer__contact-tag">dm</span>
          @mentomusica
        </a>
      </div>
    </div>

    <nav aria-label="Redes sociales">
      <ul class="footer__socials" role="list">
        {socials.map(({ name, href, icon }) => (
          <li>
            <a
              href={href}
              class="footer__social-link"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={name}
            >
              <Fragment set:html={icon} />
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <p class="footer__copy">
      <small>© {new Date().getFullYear()} mento</small>
    </p>

  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: var(--z-content);
    padding: var(--space-xl) var(--space-md) var(--space-lg);
    border-top: 1px solid var(--color-line);
  }

  .footer__inner {
    max-width: var(--max-width);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  /* Contact block */
  .footer__contact-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: var(--space-md);
  }

  .footer__contact-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer__contact-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: clamp(0.9rem, 2.5vw, 1.1rem);
    color: var(--color-text);
    text-decoration: none;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--color-line);
    width: fit-content;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .footer__contact-link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .footer__contact-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 1px;
  }

  .footer__contact-tag {
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    min-width: 2.5rem;
  }

  /* Socials */
  .footer__socials {
    display: flex;
    gap: var(--space-sm);
    list-style: none;
    align-items: center;
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    color: var(--color-text-dim);
    transition: border-color 0.18s ease, color 0.18s ease, transform 0.18s ease;
  }

  .footer__social-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    transform: translateY(-2px);
  }

  .footer__social-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* Copy */
  .footer__copy {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }
</style>
