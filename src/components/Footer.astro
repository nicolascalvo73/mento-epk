  },
  {
    name: 'Spotify',
    href: 'https://open.spotify.com/artist/1BHJGu9ALU5X7hctiGFRZa',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M7 10.2c3-1 7-.6 9.4.8M7.4 13c2.5-.8 5.7-.5 7.7.7M7.8 15.6c2-.6 4.5-.4 6.1.5"/></svg>`,
