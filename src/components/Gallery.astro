---
const photos = [
  { src: '/images/01.jpg', alt: 'mento' },
  { src: '/images/02.jpg', alt: 'mento' },
  { src: '/images/03.jpg', alt: 'mento' },
  { src: '/images/04.jpg', alt: 'mento' },
  { src: '/images/05.jpg', alt: 'mento' },
  { src: '/images/06.jpg', alt: 'mento' },
];
---

<section id="gallery" class="section gallery" aria-labelledby="gallery-heading">
  <div class="section__inner">
    <h2 id="gallery-heading" class="section-label">Photos</h2>

    <ul class="gallery__grid" role="list">
      {photos.map(({ src, alt }) => (
        <li class="gallery__item">
          <img src={src} alt={alt} loading="lazy" decoding="async" class="gallery__img" />
        </li>
      ))}
    </ul>

  </div>
</section>

<style>
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
    list-style: none;

    @media (min-width: 600px) {
      grid-template-columns: repeat(3, 1fr);
    }

    @media (min-width: 1024px) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* First item spans 2 columns */
  .gallery__item:first-child {
    grid-column: span 2;

    @media (min-width: 600px) {
      grid-column: span 1;
    }
  }

  .gallery__item {
    overflow: hidden;
    background: #111;
  }

  .gallery__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    aspect-ratio: 3/4;
    transition: transform 0.5s ease, filter 0.5s ease;
    filter: grayscale(20%);
  }

  .gallery__item:first-child .gallery__img {
    aspect-ratio: 16/9;

    @media (min-width: 600px) {
      aspect-ratio: 3/4;
    }
  }

  .gallery__item:hover .gallery__img {
    transform: scale(1.04);
    filter: grayscale(0%);
  }
</style>
