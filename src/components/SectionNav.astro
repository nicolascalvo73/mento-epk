---
// `headingId`: what a click scrolls to (the real heading, so scroll-margin-top
// lands it with breathing room). `id`: the whole section, watched by the
// IntersectionObserver to decide which nav dot is "active" while scrolling.
const sections = [
  { id: 'hero', headingId: 'hero', label: 'Inicio' },
  { id: 'bio', headingId: 'bio-heading', label: 'Bio' },
  { id: 'gallery', headingId: 'gallery-heading', label: 'Fotos' },
  { id: 'music', headingId: 'music-heading', label: 'Escuchar' },
  { id: 'video', headingId: 'video-heading', label: 'Video' },
  { id: 'subscribe', headingId: 'subscribe-heading', label: 'Quedate cerca' },
];
---

<nav class="section-nav" aria-label="Secciones">
  <ul class="section-nav__list">
    {sections.map(({ id, headingId, label }) => (
      <li>
        <button
          type="button"
          class="section-nav__dot"
          data-target={`#${id}`}
          data-scroll-target={`#${headingId}`}
          aria-label={`Ir a ${label}`}
        >
          {id !== 'hero' && (
            <span class="section-nav__label" aria-hidden="true">{label}</span>
          )}
        </button>
      </li>
    ))}
  </ul>
</nav>

<style>
  .section-nav {
    position: fixed;
    z-index: var(--z-nav);
    right: var(--space-sm);
    top: 50%;
    transform: translateY(-50%);
  }

  .section-nav__list {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    list-style: none;
  }

  .section-nav__dot {
    position: relative;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .section-nav__dot::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-muted);
    opacity: 0.5;
    transition: background 0.3s ease, opacity 0.3s ease, transform 0.3s ease;
  }

  .section-nav__dot:hover::before,
  .section-nav__dot:focus-visible::before {
    opacity: 0.9;
  }

  .section-nav__dot.is-active::before {
    background: var(--color-ember);
    opacity: 1;
    transform: scale(1.5);
  }

  .section-nav__dot:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 50%;
  }

  .section-nav__label {
    position: absolute;
    right: calc(100% + 0.6rem);
    top: 50%;
    transform: translateY(-50%) translateX(4px);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.85);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .section-nav__dot:hover .section-nav__label,
  .section-nav__dot:focus-visible .section-nav__label,
  .section-nav__dot.is-active .section-nav__label {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }

  @media (max-width: 600px) {
    .section-nav {
      right: 0.6rem;
    }

    .section-nav__list {
      gap: 0.65rem;
    }

    .section-nav__dot {
      width: 16px;
      height: 16px;
    }

    .section-nav__dot::before {
      width: 5px;
      height: 5px;
    }

    .section-nav__label {
      font-size: 0.56rem;
      right: calc(100% + 0.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-nav__dot::before,
    .section-nav__label {
      transition: none;
    }
  }
</style>

<script>
  import { getLenis } from '@/scripts/lenis';

  const nav = document.querySelector<HTMLElement>('.section-nav');
  if (nav) {
    const entries = Array.from(nav.querySelectorAll<HTMLButtonElement>('.section-nav__dot'))
      .map((btn) => {
        const selector = btn.dataset.target;
        const scrollSelector = btn.dataset.scrollTarget;
        const el = selector ? document.querySelector<HTMLElement>(selector) : null;
        const scrollEl =
          (scrollSelector ? document.querySelector<HTMLElement>(scrollSelector) : null) ?? el;
        return el && scrollEl ? { btn, el, scrollEl } : null;
      })
      .filter(
        (entry): entry is { btn: HTMLButtonElement; el: HTMLElement; scrollEl: HTMLElement } =>
          entry !== null
      );

    const setActive = (id: string) => {
      for (const { btn, el } of entries) {
        btn.classList.toggle('is-active', el.id === id);
      }
    };

    // Mark the first section active immediately — don't wait on the
    // IntersectionObserver's own (occasionally delayed) initial callback,
    // or the nav can load with no dot — and no label — marked active.
    if (entries[0]) setActive(entries[0].el.id);

    // A thin band near viewport center — whichever section crosses it is "active".
    const observer = new IntersectionObserver(
      (observed) => {
        for (const entry of observed) {
          if (entry.isIntersecting) setActive(entry.target.id);
        }
      },
      { rootMargin: '-45% 0px -50% 0px', threshold: 0 }
    );

    for (const { el } of entries) observer.observe(el);

    // The center-band observer can't see past the last section into the
    // (untracked) footer, so it goes stale once you scroll past Subscribe.
    // Force the last section active once the page is scrolled to its end.
    const lastId = entries[entries.length - 1].el.id;
    const checkBottom = () => {
      const atBottom =
        window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
      if (atBottom) setActive(lastId);
    };
    window.addEventListener('scroll', checkBottom, { passive: true });
    checkBottom();

    for (const { btn, scrollEl } of entries) {
      btn.addEventListener('click', () => {
        // scrollEl carries its own scroll-margin-top (see global.css), so
        // Lenis lands with that clearance above the heading automatically.
        const lenis = getLenis();
        if (lenis) {
          lenis.scrollTo(scrollEl, { duration: 1.3 });
        } else {
          scrollEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    }
  }
</script>
