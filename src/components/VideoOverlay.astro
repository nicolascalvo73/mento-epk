---
// Overlay rendered once in Layout; opened/closed by video-carousel.ts
---

<!--
  hidden attribute: invisible and removed from accessibility tree until opened.
  aria-modal: tells screen readers this is a modal dialog.
  Focus trap implemented in video-carousel.ts (trapFocus).
-->
<div
  class="video-overlay"
  role="dialog"
  aria-modal="true"
  aria-label="Reproductor de video"
  aria-hidden="true"
  hidden
>
  <button
    class="video-overlay__close"
    type="button"
    aria-label="Cerrar video"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <line x1="4" y1="4" x2="20" y2="20" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <line x1="20" y1="4" x2="4" y2="20" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </button>

  <div class="video-overlay__frame">
    <video
      class="video-overlay__video"
      controls
      playsinline
      preload="none"
      aria-label="Video a pantalla completa"
    ></video>
  </div>
</div>

<style>
  .video-overlay {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    background: rgba(0, 0, 0, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
    /* backdrop for click-outside detection */
  }

  .video-overlay.is-open {
    opacity: 1;
  }

  .video-overlay__frame {
    position: relative;
    width: min(90vw, 900px);
    max-height: 90svh;
    display: flex;
    align-items: center;
    justify-content: center;

    /* Zoom-in entrance */
    transform: scale(0.92);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .video-overlay.is-open .video-overlay__frame {
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .video-overlay,
    .video-overlay__frame {
      transition: none;
    }
  }

  .video-overlay__video {
    width: 100%;
    max-height: 90svh;
    object-fit: contain;
    border-radius: 2px;
    /* Full color in overlay — no grayscale filter */
  }

  .video-overlay__close {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    z-index: 1;
    color: rgba(255,255,255,0.7);
    padding: var(--space-xs);
    border-radius: 50%;
    background: rgba(0,0,0,0.5);
    line-height: 0;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .video-overlay__close:hover,
  .video-overlay__close:focus-visible {
    color: white;
    background: rgba(0,0,0,0.8);
  }

  .video-overlay__close:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
