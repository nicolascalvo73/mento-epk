---
/*
  Inlines the SVG so GSAP can target individual paths for:
  - Draw-in on load (stroke-dashoffset or DrawSVGPlugin)
  - Color changes per section (via --logo-stroke CSS custom property)

  To swap in the real logo: replace the SVG content below.
  Keep the fill/stroke via var(--logo-stroke) on all paths.
*/
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 420 100"
  fill="none"
  role="img"
  aria-label="mento"
  class="logo-svg"
>
  <!-- m -->
  <path id="logo-m"
    d="M10 80 L10 30 Q10 20 20 20 Q30 20 35 35 L50 65 L65 35 Q70 20 80 20 Q90 20 90 30 L90 80"
    stroke="var(--logo-stroke, currentColor)"
    stroke-width="5"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <!-- e -->
  <path id="logo-e"
    d="M110 50 Q110 20 130 20 Q150 20 150 50 Q150 80 130 80 Q110 80 110 50 Z M110 50 L148 50"
    stroke="var(--logo-stroke, currentColor)"
    stroke-width="5"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <!-- n -->
  <path id="logo-n"
    d="M170 80 L170 20 L210 80 L210 20"
    stroke="var(--logo-stroke, currentColor)"
    stroke-width="5"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <!-- t stem -->
  <path id="logo-t-stem"
    d="M250 20 L250 80"
    stroke="var(--logo-stroke, currentColor)"
    stroke-width="5"
    stroke-linecap="round"
  />
  <!-- t crossbar -->
  <path id="logo-t-bar"
    d="M230 30 L270 30"
    stroke="var(--logo-stroke, currentColor)"
    stroke-width="5"
    stroke-linecap="round"
  />
  <!-- o -->
  <path id="logo-o"
    d="M290 50 Q290 20 310 20 Q330 20 330 50 Q330 80 310 80 Q290 80 290 50 Z"
    stroke="var(--logo-stroke, currentColor)"
    stroke-width="5"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>

<style>
  .logo-svg {
    width: 100%;
    height: auto;
    color: var(--color-text);   /* drives currentColor → --logo-stroke fallback */
    display: block;
  }
</style>
