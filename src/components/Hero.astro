---
// Hero is intentionally minimal: the logo (rendered in Layout) fills this space.
// This section provides the scroll distance that triggers the logo shrink animation.

const socials = [
  {
    name: 'Instagram',
    href: 'https://www.instagram.com/mentomusica',
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r="0.6" fill="currentColor" stroke="none"/></svg>`,
  },
  {
    name: 'Spotify',
    href: 'https://open.spotify.com/artist/1BHJGu9ALU5X7hctiGFRZa',
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M7 10.2c3-1 7-.6 9.4.8M7.4 13c2.5-.8 5.7-.5 7.7.7M7.8 15.6c2-.6 4.5-.4 6.1.5"/></svg>`,
  },
  {
    name: 'YouTube',
    href: 'https://www.youtube.com/@mentomusica',
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="4"/><path d="M10.5 9.5v5l4.3-2.5z" fill="currentColor" stroke="none"/></svg>`,
  },
  {
    name: 'TikTok',
    href: 'https://www.tiktok.com/@mentomusica',
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3v10.5a3.5 3.5 0 1 1-3-3.46"/><path d="M14 3c.4 2.2 2 3.8 4 4.2"/></svg>`,
  },
  {
    name: 'WhatsApp',
    href: `https://wa.me/5493549432720?text=${encodeURIComponent('Hola mento!')}`,
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a8.5 8.5 0 0 0-7.4 12.7L3.5 20l4.4-1.1A8.5 8.5 0 1 0 12 3Z"/><path d="M8.7 8.4c.2-.5.4-.5.6-.5h.4c.2 0 .4 0 .5.4.2.5.6 1.6.6 1.7.1.1.1.3 0 .4-.1.2-.2.3-.3.4l-.4.4c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.6-.1l.6-.7c.2-.2.4-.2.6-.1l1.5.7c.2.1.4.2.4.4.1.5-.1 1.4-.6 1.7-.5.4-1 .6-1.8.5-.7-.1-2.9-1-4.4-2.7-1.5-1.6-2-3.2-2.1-3.6-.1-.4-.5-1.6-.2-2.1Z"/></svg>`,
  },
];
---

<section id="hero" class="hero" aria-label="mento">
  <!--
    The visible "mento" logo lives in Layout as a fixed element.
    This section's height is what ScrollTrigger uses as the scrub distance
    for the logo shrink. Content here is the visual "behind" the logo.
  -->
  <p class="hero__tagline">Hacemos el ruido que se queda después del silencio.</p>

  <nav class="hero__socials" aria-label="Redes sociales">
    <ul class="hero__socials-list" role="list">
      {socials.map(({ name, href, icon }) => (
        <li>
          <a
            href={href}
            class="hero__social-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={name}
          >
            <Fragment set:html={icon} />
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="hero__scroll-hint" aria-hidden="true">
    <span class="hero__scroll-line"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: var(--space-lg);
  }

  .hero__tagline {
    position: relative;
    z-index: 0;
    font-family: var(--font-body);
    font-size: clamp(0.85rem, 2vw, 1.1rem);
    color: var(--color-text-dim);
    letter-spacing: 0.02em;
    text-align: center;
    max-width: 28rem;
    line-height: 1.5;
  }

  .hero__tagline::before {
    content: '';
    position: absolute;
    inset: -1rem;
    z-index: -1;
    background: rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 2px;
  }

  .hero__socials {
    margin-top: 2rem;
    margin-bottom: var(--space-lg);
  }

  .hero__socials-list {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-sm);
    list-style: none;
  }

  .hero__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.375rem;
    height: 3.375rem;
    color: var(--color-text-dim);
    transition: color 0.18s ease, transform 0.18s ease;
  }

  .hero__social-link svg {
    width: 2rem;
    height: 2rem;
  }

  .hero__social-link:hover {
    color: var(--color-accent);
    transform: translateY(-2px);
  }

  .hero__social-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 50%;
  }

  .hero__scroll-hint {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    opacity: 0.4;
    animation: hint-fade 2s ease-in-out infinite alternate;
  }

  .hero__scroll-line {
    display: block;
    width: 1px;
    height: 60px;
    background: linear-gradient(to bottom, transparent, var(--color-text));
    animation: hint-grow 2s ease-in-out infinite alternate;
  }

  @keyframes hint-fade {
    from { opacity: 0.2; }
    to   { opacity: 0.5; }
  }

  @keyframes hint-grow {
    from { transform: scaleY(0.5); }
    to   { transform: scaleY(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-hint,
    .hero__scroll-line {
      animation: none;
      opacity: 0.3;
    }
  }
</style>
